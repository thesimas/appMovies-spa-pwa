{
  "$schema": "http://json.schemastore.org/web-manifest",
  "short_name": "Cine PWA",
  "name": "CinePWA - Catálogo de Filmes",
  "description": "Modelo de catálago de filmes feito em Javascript, Bootstrap, Axios e aplicando conceitos de SPA e PWA, além de consumir a API TMDB(THE MOVIE DATABASE)!",
  "scope": "./",
  "icons": [
    {
      "src": "imagens/pipoca.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "imagens/pipoca.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "background_color": "#4b0082",
  "theme_color": "#4b0082",
  "start_url": "./index.html",
  "display": "standalone",
  "orientation": "portrait"
}